{
	"name": "zed-101-setup",
	"type": "module",
	"scripts": {
		"start": "bun run cli.ts",
		"dev": "bun run --hot cli.ts",
		"test": "bash tests/scripts.sh",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"check": "bun run test && bun run typecheck && bun run lint"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/bun": "1.4.2",
		"typescript": "7.0.2"
	}
}
